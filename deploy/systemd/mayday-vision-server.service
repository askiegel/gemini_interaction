[Unit]
Description=Mayday YOLO Vision Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tkieg
WorkingDirectory=/home/tkieg/robot_services/cognitive
Environment=HOME=/home/tkieg
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/tkieg/robot_services/cognitive/.venv/bin/python3 /home/tkieg/robot_services/cognitive/scripts/run_tony2_service.py vision-server
ExecStopPost=/usr/bin/rm -f /home/tkieg/robot_services/cognitive/.run/vision_server.pid
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target
