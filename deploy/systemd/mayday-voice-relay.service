[Unit]
Description=Mayday Voice Relay and Dashboard
Wants=mayday-cognitive-runtime.service
After=mayday-cognitive-runtime.service

[Service]
Type=simple
User=tkieg
WorkingDirectory=/home/tkieg/robot_services/cognitive
Environment=HOME=/home/tkieg
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/tkieg/robot_services/cognitive/.env
ExecStartPre=/usr/bin/bash -lc 'for i in {1..60}; do /usr/bin/curl -fsS --max-time 2 http://127.0.0.1:8770/health >/dev/null && exit 0; sleep 1; done; exit 1'
ExecStart=/home/tkieg/robot_services/cognitive/.venv/bin/python3 /home/tkieg/robot_services/cognitive/scripts/run_tony2_service.py voice-relay
ExecStopPost=/usr/bin/rm -f /home/tkieg/robot_services/cognitive/.run/voice_relay.pid
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target
